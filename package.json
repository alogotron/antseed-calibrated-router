  },
  "peerDependencies": {
    "@antseed/node": ">=0.2.150"
  },
  "devDependencies": {
    "@antseed/node": "0.2.150",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alogotron/antseed-calibrated-router.git"
  }
